      }
    },
    "Try again after closing other immersive experiences.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again after closing other immersive experiences."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente após fechar outras experiências imersivas."
          }
        }
      }
    },
    "Build %@": {
      "localizations": {
        "en": {
          "stringUnit": {
